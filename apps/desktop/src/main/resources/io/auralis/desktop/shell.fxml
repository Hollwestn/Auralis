<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:id="root" fx:controller="io.auralis.desktop.MainController" styleClass="shell">
 <left><ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" prefWidth="202" minWidth="172" minHeight="0" styleClass="sidebar-scroll"><content><VBox fx:id="sidebar" spacing="5" prefWidth="202" styleClass="sidebar">
  <HBox alignment="CENTER_LEFT" spacing="9" styleClass="brand"><ImageView fitWidth="48" fitHeight="48" preserveRatio="true"><image><Image url="@auralis-icon.png"/></image></ImageView><VBox spacing="1"><Label text="auralis" styleClass="brand-name"/><Label text="YOUR SOUND. YOUR SPACE." styleClass="brand-caption"/></VBox></HBox>
  <Label text="ОБЗОР" styleClass="nav-caption"/>
  <Button fx:id="homeNav" text="Главная" userData="home" onAction="#showHome" styleClass="nav-button" maxWidth="Infinity"/>
  <Button text="Моя волна" userData="wave" onAction="#showWave" styleClass="nav-button" maxWidth="Infinity"/>
  <Button text="Медиатека" userData="library" onAction="#showLibrary" styleClass="nav-button" maxWidth="Infinity"/>
  <Button text="Любимые треки" userData="heart" onAction="#showFavorites" styleClass="nav-button" maxWidth="Infinity"/>
  <Button text="История" userData="history" onAction="#showHistory" styleClass="nav-button" maxWidth="Infinity"/>
  <HBox alignment="CENTER_LEFT" spacing="8" styleClass="playlist-heading"><Label text="ВАША МУЗЫКА" styleClass="nav-caption"/><Region HBox.hgrow="ALWAYS"/><Button text="+" onAction="#createPlaylist" styleClass="tiny-button"/></HBox>
  <VBox fx:id="playlistNav" spacing="3"/>
  <Button text="Новый плейлист" userData="plus" onAction="#createPlaylist" styleClass="nav-button, muted-button" maxWidth="Infinity"/>
  <Region VBox.vgrow="ALWAYS" minHeight="18"/>
  <VBox fx:id="advancedNav" spacing="5"><Label text="СТУДИЯ" styleClass="nav-caption"/><Button text="Аудиостудия" userData="studio" onAction="#showEditor" styleClass="nav-button" maxWidth="Infinity"/><Button text="Эквалайзер" userData="equalizer" onAction="#showEqualizer" styleClass="nav-button" maxWidth="Infinity"/></VBox>
  <Button text="Настройки" userData="settings" onAction="#showSettings" styleClass="nav-button" maxWidth="Infinity"/>
  <HBox spacing="8" alignment="CENTER_LEFT" styleClass="local-badge"><Label text="●" styleClass="online-dot"/><VBox spacing="2"><Label fx:id="connectionLabel" text="Локальная коллекция" styleClass="connection-title"/><Label text="Музыка принадлежит вам" styleClass="micro"/></VBox></HBox>
 </VBox></content></ScrollPane></left>
 <center><StackPane fx:id="workspaceStack" styleClass="workspace-stack"><Pane fx:id="ambientHost" mouseTransparent="true"/><BorderPane styleClass="workspace"><top><HBox spacing="14" alignment="CENTER_LEFT" styleClass="topbar"><VBox spacing="3"><Label fx:id="breadcrumb" text="Главная" styleClass="breadcrumb"/><Label text="Ваша музыка. Ваше пространство." styleClass="micro"/></VBox><Region HBox.hgrow="ALWAYS"/><TextField fx:id="searchField" promptText="Треки, альбомы, исполнители" prefWidth="290"/><Button text="Добавить музыку" userData="plus" onAction="#importMusic" styleClass="header-add"/></HBox></top><center><StackPane fx:id="pageHost"/></center><bottom><HBox styleClass="statusbar" spacing="9" alignment="CENTER_LEFT"><ProgressIndicator fx:id="busy" prefWidth="13" prefHeight="13" visible="false" managed="false"/><Label fx:id="statusLabel" text="Ваша музыка. Ваше пространство." styleClass="micro"/></HBox></bottom></BorderPane></StackPane></center>
 <right><ScrollPane fx:id="rightDockScroll" fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" minHeight="0" prefWidth="278" styleClass="dock-scroll"><content><VBox fx:id="rightDock" spacing="18" styleClass="right-dock">
  <HBox alignment="CENTER_LEFT"><Label text="СЕЙЧАС ИГРАЕТ" styleClass="eyebrow"/><Region HBox.hgrow="ALWAYS"/><Button text="" userData="expand" onAction="#fullPlayer" styleClass="icon-button"/></HBox>
  <StackPane fx:id="dockCover" prefHeight="224" minHeight="224" maxHeight="224" styleClass="dock-cover"><Label text="a" styleClass="idle-cover-mark"/></StackPane>
  <VBox spacing="7"><Label fx:id="dockTitle" text="Включите свою музыку" wrapText="true" styleClass="dock-track-title"/><Label fx:id="dockArtist" text="Выберите трек в коллекции" wrapText="true" styleClass="muted"/></VBox>
  <Label fx:id="dockQuality" text="Локальная музыка · без подписки" styleClass="quality-badge"/>
  <HBox spacing="10" alignment="CENTER"><Button text="" userData="previous" onAction="#previous" styleClass="icon-button"/><Button fx:id="dockPlayButton" text="" userData="play" onAction="#togglePlay" styleClass="play-button"/><Button text="" userData="next" onAction="#next" styleClass="icon-button"/><Button fx:id="dockLikeButton" text="" userData="heart" onAction="#toggleLike" styleClass="icon-button"/></HBox>
  <Separator/>
  <HBox alignment="CENTER_LEFT"><Label text="Далее в очереди" styleClass="dock-section-title"/><Region HBox.hgrow="ALWAYS"/><Button text="Все" onAction="#showQueue" styleClass="text-button"/></HBox>
  <VBox fx:id="dockQueue" spacing="9"><Label text="Выберите композицию, чтобы начать" wrapText="true" styleClass="muted"/></VBox>
  <Region VBox.vgrow="ALWAYS"/>
  <VBox spacing="9" styleClass="dock-tip"><Label text="ВАШ ЛИЧНЫЙ ЭФИР" styleClass="eyebrow"/><Label text="Моя волна узнаёт ваш вкус." wrapText="true" styleClass="dock-section-title"/><Button text="Открыть волну" userData="arrow" onAction="#showWave" styleClass="text-button"/></VBox>
 </VBox></content></ScrollPane></right>
 <bottom><VBox styleClass="player" spacing="0"><Slider fx:id="seek" min="0" max="1" value="0" styleClass="seek"/><HBox spacing="15" alignment="CENTER_LEFT" styleClass="player-inner"><StackPane fx:id="coverHost" prefWidth="52" prefHeight="52" minWidth="52" styleClass="cover-small"><Label text="a" styleClass="cover-note"/></StackPane><VBox prefWidth="220" minWidth="100" spacing="5"><Label fx:id="trackTitle" text="Ваша музыка ждёт" styleClass="track-title"/><Label fx:id="trackArtist" text="Добавьте любимые композиции" styleClass="muted"/></VBox><Button fx:id="likeButton" text="" userData="heart" onAction="#toggleLike" styleClass="icon-button"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="shuffleButton" text="" userData="shuffle" onAction="#toggleShuffle" styleClass="icon-button"/><Button text="" userData="previous" onAction="#previous" styleClass="icon-button"/><Button fx:id="playButton" text="" userData="play" onAction="#togglePlay" styleClass="play-button"/><Button text="" userData="next" onAction="#next" styleClass="icon-button"/><Button fx:id="repeatButton" text="" userData="repeat" onAction="#toggleRepeat" styleClass="icon-button"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="timeLabel" text="0:00 / 0:00" styleClass="muted"/><Button text="" userData="queue" onAction="#showQueue" styleClass="icon-button"/><Button text="" userData="expand" onAction="#fullPlayer" styleClass="icon-button"/><HBox fx:id="volumeGroup" spacing="8" alignment="CENTER_LEFT"><Label text="Звук" styleClass="micro"/><Slider fx:id="volume" min="0" max="1" value="0.75" prefWidth="76"/></HBox></HBox></VBox></bottom>
</BorderPane>
