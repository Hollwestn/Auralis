{
  "name": "auralis-mobile",
  "version": "0.8.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/slider": "5.2.1",
    "expo": "~58.0.14",
    "expo-audio": "~58.0.9",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.9",
    "expo-gl": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.23",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --no-install --no-clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests app.config.ts",
    "test": "node --experimental-transform-types --test tests/*.test.mjs",
    "postinstall": "node scripts/patch-expo-audio.cjs",
    "export:android": "expo export --platform android",
    "export:ios": "expo export --platform ios"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-audio"
        ]
      },
      "ios": {
        "buildFromSource": [
          "expo-audio"
        ]
      }
    }
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    },
    "node-forge": "1.4.2",
    "xml2js": "0.6.2"
  }
}
