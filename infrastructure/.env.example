# Copy to .env. Never commit the real .env.
AURALIS_DB_PASSWORD=replace-with-a-long-random-password
AURALIS_HTTP_BIND=127.0.0.1
AURALIS_DOMAIN=music.example.com
AURALIS_MAX_USER_BYTES=21474836480
# Explicit local folder import. Disabled unless BOTH values are set.
# Copy permitted music into infrastructure/import; this folder is mounted read-only.
AURALIS_IMPORT_ROOT=
# Register your account first, then copy its immutable id from GET /api/v1/account.
AURALIS_IMPORT_ADMIN_USER_ID=
